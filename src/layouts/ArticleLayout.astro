---
import Layout from './Layout.astro';
import { profile } from '../data/cv';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  backHref: string;
  backLabel: string;
  tags: string[];
}

const { title, description, pubDate, updatedDate, backHref, backLabel, tags } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  author: { '@type': 'Person', name: profile.name },
};
---

<Layout title={title} description={description} type="article" structuredData={structuredData}>
  <article>
    <header class="mb-8">
      <a href={backHref} class="text-sm font-medium text-sky-600 dark:text-sky-400">
        {backLabel}
      </a>
      <h1 class="mt-2 text-3xl font-bold tracking-tight">{title}</h1>
      <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-slate-500 dark:text-slate-400">
        <time datetime={pubDate.toISOString()}>{dateFormatter.format(pubDate)}</time>
        {updatedDate && <span>(updated {dateFormatter.format(updatedDate)})</span>}
        {tags.length > 0 && <span>{tags.map((t) => `#${t}`).join(' ')}</span>}
      </div>
    </header>
    <div class="prose prose-invert max-w-none">
      <slot />
    </div>
  </article>
</Layout>
