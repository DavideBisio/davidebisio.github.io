---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  category: 'hobby' | 'professional';
  tags: string[];
}

const { title, description, pubDate, updatedDate, category, tags } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout title={title} description={description}>
  <article>
    <header class="mb-8">
      <a
        href={`/articles/${category}/`}
        class="text-sm font-medium text-sky-600 dark:text-sky-400"
      >
        {category === 'hobby' ? 'Hobbies' : 'Professional'}
      </a>
      <h1 class="mt-2 text-3xl font-bold tracking-tight">{title}</h1>
      <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-slate-500 dark:text-slate-400">
        <time datetime={pubDate.toISOString()}>{dateFormatter.format(pubDate)}</time>
        {updatedDate && <span>(updated {dateFormatter.format(updatedDate)})</span>}
        {tags.length > 0 && <span>{tags.map((t) => `#${t}`).join(' ')}</span>}
      </div>
    </header>
    <div class="prose prose-slate max-w-none dark:prose-invert">
      <slot />
    </div>
  </article>
</Layout>
