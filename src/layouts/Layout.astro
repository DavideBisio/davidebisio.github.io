---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
  snapScroll?: boolean;
  type?: 'website' | 'article';
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description = 'Personal site of Davide Bisio.',
  wide = false,
  snapScroll = false,
  type = 'website',
  structuredData,
} = Astro.props;
const pageTitle = title === 'Davide Bisio' ? title : `${title} · Davide Bisio`;
---

<!doctype html>
<html lang="en" class:list={[snapScroll && 'snap-y snap-proximity']}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{pageTitle}</title>
    <script data-goatcounter="https://davidebisio.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body class="flex min-h-screen flex-col">
    <Header wide={wide} />
    <main class:list={['mx-auto w-full flex-1 px-4 py-10', wide ? 'max-w-6xl' : 'max-w-3xl']}>
      <slot />
    </main>
    <Footer wide={wide} />
  </body>
</html>
