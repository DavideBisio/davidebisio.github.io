---
interface Props {
  wide?: boolean;
}
const { wide = false } = Astro.props;
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/cv/', label: 'CV' },
  { href: '/articles/', label: 'Articles' },
  { href: '/interests/', label: 'Interests' },
  { href: '/travel/', label: 'Travel' },
  { href: '/contact/', label: 'Contact' },
];
const currentPath = Astro.url.pathname;
---

<header class="border-b border-slate-200 dark:border-slate-800">
  <nav class:list={['mx-auto flex flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-4', wide ? 'max-w-6xl' : 'max-w-3xl']}>
    <a href="/" class="flex shrink-0 items-center gap-3 font-semibold tracking-tight whitespace-nowrap">
      <img src="/logo.jpg" alt="" width="256" height="192" class="h-9 w-auto rounded-md" />
      Davide Bisio
    </a>
    <ul class="flex flex-wrap gap-x-5 gap-y-1 text-sm sm:gap-x-6">
      {
        navItems.map((item) => {
          const isActive =
            item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
          return (
            <li>
              <a
                href={item.href}
                class:list={[
                  'transition-colors hover:text-sky-600 dark:hover:text-sky-400',
                  isActive
                    ? 'font-medium text-sky-600 dark:text-sky-400'
                    : 'text-slate-600 dark:text-slate-400',
                ]}
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>
