---
import type { CollectionEntry } from 'astro:content';

interface Props {
  articles: CollectionEntry<'articles'>[];
  activeCategory: 'hobby' | 'professional' | null;
}

const { articles, activeCategory } = Astro.props;

const categories = [
  { value: null, label: 'All', href: '/articles/' },
  { value: 'professional', label: 'Professional', href: '/articles/professional/' },
  { value: 'hobby', label: 'Hobbies', href: '/articles/hobby/' },
] as const;

const sorted = [...articles].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const dateFormatter = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<div class="mb-8 flex gap-2 text-sm">
  {
    categories.map((c) => (
      <a
        href={c.href}
        class:list={[
          'rounded-full border px-3 py-1 transition-colors',
          activeCategory === c.value
            ? 'border-sky-600 bg-sky-600 text-white'
            : 'border-slate-300 text-slate-600 hover:border-sky-600 hover:text-sky-600 dark:border-slate-700 dark:text-slate-400',
        ]}
      >
        {c.label}
      </a>
    ))
  }
</div>

{sorted.length === 0 && <p class="text-slate-500 dark:text-slate-400">No articles yet in this category.</p>}

<ul class="space-y-6">
  {
    sorted.map((article) => (
      <li>
        <a href={`/articles/${article.id}/`} class="group block">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <p class="font-medium group-hover:text-sky-600 dark:group-hover:text-sky-400">{article.data.title}</p>
            <time datetime={article.data.pubDate.toISOString()} class="shrink-0 text-sm text-slate-500 dark:text-slate-400">
              {dateFormatter.format(article.data.pubDate)}
            </time>
          </div>
          <p class="text-sm text-slate-600 dark:text-slate-400">{article.data.description}</p>
        </a>
      </li>
    ))
  }
</ul>
