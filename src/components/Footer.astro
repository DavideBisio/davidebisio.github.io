---
import { profile } from '../data/cv';
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-slate-200 py-8 text-sm text-slate-500 dark:border-slate-800 dark:text-slate-400">
  <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-4 px-4">
    <p>&copy; {year} {profile.name}</p>
    <ul class="flex gap-4">
      {
        profile.links.map((link) => (
          <li>
            <a href={link.url} class="hover:text-sky-600 dark:hover:text-sky-400" target="_blank" rel="noopener noreferrer">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
