---
import Layout from '../../layouts/Layout.astro';
import SkillsTree from '../../components/SkillsTree';
import { profile, experience, education, skillsTree } from '../../data/cv';
---

<Layout title="CV" description={`CV of ${profile.name}, ${profile.title}.`}>
  <div class="mb-8 flex items-start justify-between gap-4 print:hidden">
    <div>
      <h1 class="text-2xl font-bold tracking-tight">CV</h1>
      <p class="text-slate-600 dark:text-slate-400">{profile.name} &middot; {profile.title}</p>
    </div>
    <a
      href="/cv.pdf"
      download
      class="shrink-0 rounded-md bg-sky-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-sky-700"
    >
      Download PDF
    </a>
  </div>

  <section class="mb-10">
    <h2 class="mb-3 text-lg font-semibold">Experience</h2>
    <ul class="space-y-6">
      {
        experience.map((job) => (
          <li>
            <div class="flex flex-wrap items-baseline justify-between gap-x-4">
              <p class="font-medium">
                {job.role} &middot; {job.company}
              </p>
              <p class="text-sm text-slate-500 dark:text-slate-400">
                {job.start} – {job.end ?? 'Present'}
              </p>
            </div>
            <ul class="mt-1 list-disc space-y-1 pl-5 text-sm text-slate-700 dark:text-slate-300">
              {job.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mb-10">
    <h2 class="mb-3 text-lg font-semibold">Education</h2>
    <ul class="space-y-4">
      {
        education.map((edu) => (
          <li class="flex flex-wrap items-baseline justify-between gap-x-4">
            <p class="font-medium">
              {edu.degree} &middot; {edu.school}
            </p>
            <p class="text-sm text-slate-500 dark:text-slate-400">
              {edu.start} – {edu.end ?? 'Present'}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <h2 class="mb-3 text-lg font-semibold">Skills</h2>
    <SkillsTree client:load data={skillsTree} />
  </section>
</Layout>

<style is:global>
  @media print {
    header,
    footer {
      display: none;
    }
  }
</style>
