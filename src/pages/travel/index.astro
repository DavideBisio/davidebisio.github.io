---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { sortTripsByDate, tripSlug } from '../../lib/trips';

const trips = sortTripsByDate(await getCollection('trips', ({ data }) => !data.draft));
const dateFormatter = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

function formatRange(start: Date, end: Date): string {
  const startStr = dateFormatter.format(start);
  const endStr = dateFormatter.format(end);
  return startStr === endStr ? startStr : `${startStr} – ${endStr}`;
}
---

<Layout title="Travel log" description="A timeline of trips.">
  <h1 class="mb-6 text-2xl font-bold tracking-tight">Travel log</h1>

  {trips.length === 0 && <p class="text-slate-500 dark:text-slate-400">No trips logged yet — check back soon.</p>}

  <ol class="relative space-y-8 border-l border-slate-200 pl-6 dark:border-teal">
    {
      trips.map((trip) => (
        <li class="relative">
          <span class="absolute -left-[1.6rem] top-1.5 h-2.5 w-2.5 rounded-full bg-amber" />
          <a href={`/travel/${tripSlug(trip)}/`} class="group block">
            <time class="text-sm text-slate-500 dark:text-slate-400">
              {formatRange(trip.data.startDate, trip.data.endDate)}
            </time>
            <p class="font-medium group-hover:text-sky-600 dark:group-hover:text-sky-400">{trip.data.title}</p>
            <p class="text-sm text-slate-600 dark:text-slate-400">
              {trip.data.location}
              {trip.data.country ? `, ${trip.data.country}` : ''}
            </p>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{trip.data.description}</p>
          </a>
        </li>
      ))
    }
  </ol>
</Layout>
