---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import path from 'node:path';
import fs from 'node:fs';
import exifr from 'exifr';
import Layout from '../../../layouts/Layout.astro';
import DayFocusMap from '../../../components/DayFocusMap.tsx';
import Lightbox from '../../../components/Lightbox.astro';
import { parseGpx, parseTracks, parseWaypoints, buildGpxFile, haversineKm } from '../../../lib/gpx';
import type { JourneyDay, JourneyTrack } from '../../../lib/journey';
import { renderNotesHtml } from '../../../lib/notes';
import { tripSlug, sortDaysByDate } from '../../../lib/trips';

export async function getStaticPaths() {
  const trips = await getCollection('trips', ({ data }) => !data.draft);
  return trips.map((trip) => ({
    params: { trip: tripSlug(trip) },
    props: { trip },
  }));
}

const { trip } = Astro.props as { trip: CollectionEntry<'trips'> };
const { Content } = await render(trip);
const days = sortDaysByDate(trip.data.days);

const dateFormatter = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const dayFormatter = new Intl.DateTimeFormat('en-US', { weekday: 'long', month: 'short', day: 'numeric' });

function labelFromFilename(filename: string): string {
  const base = filename.split('/').pop()!.replace(/\.gpx$/i, '');
  return base.replace(/[-_]+/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
}

function dateKey(date: Date): string {
  return date.toISOString().slice(0, 10);
}

function trackDateLabel(date: Date): string {
  const dd = String(date.getUTCDate()).padStart(2, '0');
  const mm = String(date.getUTCMonth() + 1).padStart(2, '0');
  return `${dd}/${mm}/${date.getUTCFullYear()}`;
}

const tripDir = trip.filePath ? path.posix.dirname(trip.filePath) : null;
const tripDirAbs = tripDir ? path.join(process.cwd(), tripDir) : null;

// GPX files are colocated with the trip's markdown but aren't part of the
// schema's markdown/image pipeline, so resolve + parse them at build time.
const gpxUrls = import.meta.glob('/src/content/trips/**/gpx/*.gpx', {
  query: '?url',
  import: 'default',
  eager: true,
}) as Record<string, string>;

const imageModules = import.meta.glob('/src/content/trips/**/jpg/*.{jpg,jpeg}', {
  eager: true,
  import: 'default',
}) as Record<string, ImageMetadata>;

interface ActivityTrackEntry {
  label: string;
  track: ReturnType<typeof parseGpx>;
  href: string | null;
}

interface RouteFile {
  routeTracks: ReturnType<typeof parseTracks>;
  waypoints: ReturnType<typeof parseWaypoints>;
}

interface RouteDownload {
  track: ReturnType<typeof parseGpx>;
  href: string;
  filename: string;
}

// A waypoint counts as "on" a day if it's within this distance of that day's
// own tracks — picked empirically from the real trip data: every waypoint's
// nearest matching day's track is within ~3.4km, while the next-nearest
// unrelated day is always 5km+ away, so this sits squarely in the gap.
const WAYPOINT_RADIUS_KM = 3.5;

// Reads every .gpx file under the trip's `gpx/` folder. A filename ending in
// "-route.gpx" is the trip's single combined routes+waypoints file (one
// <trk> per day, named "Route DD/MM/YYYY", plus shared <wpt> waypoints).
// Every other file is a per-day activity track, matched to its day by the
// date embedded in its own points — not by filename — so files can be named
// freely (the import script names them after the activity).
function loadGpxFiles(): { activityTracksByDate: Map<string, ActivityTrackEntry[]>; routeFile: RouteFile | null } {
  const activityTracksByDate = new Map<string, ActivityTrackEntry[]>();
  let routeFile: RouteFile | null = null;
  if (!tripDirAbs || !tripDir) return { activityTracksByDate, routeFile };

  const gpxDir = path.join(tripDirAbs, 'gpx');
  if (!fs.existsSync(gpxDir)) return { activityTracksByDate, routeFile };

  for (const filename of fs.readdirSync(gpxDir)) {
    if (!filename.toLowerCase().endsWith('.gpx')) continue;
    const xml = fs.readFileSync(path.join(gpxDir, filename), 'utf-8');

    if (filename.toLowerCase().endsWith('-route.gpx')) {
      routeFile = { routeTracks: parseTracks(xml), waypoints: parseWaypoints(xml) };
      continue;
    }

    const track = parseGpx(xml);
    if (!track.startTime) throw new Error(`${filename}: no <time> on its points, can't match it to a day`);
    const relPath = path.posix.join(tripDir, 'gpx', filename);
    const entry: ActivityTrackEntry = {
      label: labelFromFilename(filename),
      track,
      href: gpxUrls[`/${relPath}`] ?? null,
    };
    const key = track.startTime.slice(0, 10);
    if (!activityTracksByDate.has(key)) activityTracksByDate.set(key, []);
    activityTracksByDate.get(key)!.push(entry);
  }
  for (const entries of activityTracksByDate.values()) {
    entries.sort((a, b) => (a.track.startTime ?? '').localeCompare(b.track.startTime ?? ''));
  }
  return { activityTracksByDate, routeFile };
}

const { activityTracksByDate, routeFile } = loadGpxFiles();

// Reads every .jpg/.jpeg under the trip's `jpg/` folder and groups them by
// the calendar date in their own EXIF "date taken" tag — not the file's
// modify date, which for Lightroom-exported files reflects export time, not
// capture time.
async function loadPhotosByDate(): Promise<Map<string, ImageMetadata[]>> {
  const byDate = new Map<string, ImageMetadata[]>();
  if (!tripDirAbs || !tripDir) return byDate;

  const jpgDir = path.join(tripDirAbs, 'jpg');
  if (!fs.existsSync(jpgDir)) return byDate;

  const filenames = fs.readdirSync(jpgDir).filter((f) => /\.jpe?g$/i.test(f));
  await Promise.all(
    filenames.map(async (filename) => {
      const absPath = path.join(jpgDir, filename);
      const exif = await exifr.parse(absPath, ['DateTimeOriginal', 'CreateDate']);
      const taken: Date | undefined = exif?.DateTimeOriginal ?? exif?.CreateDate;
      if (!taken) {
        console.warn(`${filename}: no DateTimeOriginal/CreateDate EXIF tag, skipping`);
        return;
      }
      const relPath = path.posix.join(tripDir!, 'jpg', filename);
      const image = imageModules[`/${relPath}`];
      if (!image) {
        console.warn(`${filename}: not found among globbed image assets, skipping`);
        return;
      }
      const key = dateKey(taken);
      if (!byDate.has(key)) byDate.set(key, []);
      byDate.get(key)!.push(image);
    }),
  );
  for (const images of byDate.values()) images.sort((a, b) => a.src.localeCompare(b.src));
  return byDate;
}

const photosByDate = await loadPhotosByDate();

async function loadPhotos(images: ImageMetadata[]) {
  return Promise.all(
    images.map(async (img) => ({
      thumb: await getImage({ src: img, width: 200, height: 150 }),
      full: await getImage({ src: img, width: 1600 }),
    })),
  );
}

const dayExtras = await Promise.all(
  days.map(async (day) => {
    const key = dateKey(day.date);
    return {
      tracks: activityTracksByDate.get(key) ?? [],
      photos: await loadPhotos(photosByDate.get(key) ?? []),
    };
  }),
);

// Indexed by day index, independent of the journey map: the per-day route
// download link is shown in each day's description whether or not the trip
// has a journey map at all.
const routeDownloads: (RouteDownload | null)[] = days.map((day) => {
  if (!routeFile) return null;
  const routeName = `Route ${trackDateLabel(day.date)}`;
  const routeTrack = routeFile.routeTracks.find((t) => t.name === routeName && t.points.length > 0);
  if (!routeTrack) return null;
  const gpxXml = buildGpxFile(routeName, routeTrack.points);
  return {
    track: routeTrack,
    href: `data:application/gpx+xml;base64,${Buffer.from(gpxXml).toString('base64')}`,
    filename: `route-${day.date.toISOString().slice(0, 10)}.gpx`,
  };
});

function waypointsNearDay(points: [number, number][]) {
  if (!routeFile) return [];
  return routeFile.waypoints.filter((wpt) =>
    points.some(([lat, lon]) => haversineKm({ lat, lon }, wpt) <= WAYPOINT_RADIUS_KM),
  );
}

const journeyDays: JourneyDay[] = days
  .map((day, i): JourneyDay => {
    const tracks: JourneyTrack[] = dayExtras[i].tracks.map((entry) => ({
      label: entry.label,
      points: entry.track.points.map((p) => [p.lat, p.lon] as [number, number]),
      variant: 'activity' as const,
    }));

    const routeDownload = routeDownloads[i];
    if (routeDownload) {
      tracks.push({
        label: routeDownload.track.name ?? 'Route',
        points: routeDownload.track.points.map((p) => [p.lat, p.lon] as [number, number]),
        variant: 'route',
      });
    }

    const dayPoints = tracks.flatMap((t) => t.points);
    return { dayIndex: i, label: day.title, tracks, waypoints: waypointsNearDay(dayPoints) };
  })
  .filter((d) => d.tracks.some((t) => t.points.length > 0));

const hasJourney = journeyDays.length > 0;
---

<Layout title={trip.data.title} description={trip.data.description} wide={hasJourney} snapScroll={hasJourney}>
  <a href="/travel/" class="text-sm font-medium text-sky-600 dark:text-sky-400">Travel log</a>

  <header class="mt-2 mb-8">
    <h1 class="text-3xl font-bold tracking-tight">{trip.data.title}</h1>
    <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-slate-500 dark:text-slate-400">
      <span>
        {dateFormatter.format(trip.data.startDate)} – {dateFormatter.format(trip.data.endDate)}
      </span>
      <span>
        {trip.data.location}
        {trip.data.country ? `, ${trip.data.country}` : ''}
      </span>
      {trip.data.tags.length > 0 && <span>{trip.data.tags.map((t) => `#${t}`).join(' ')}</span>}
    </div>
  </header>

  <div class="prose prose-slate max-w-none dark:prose-invert">
    <Content />
  </div>

  {days.length > 0 && <h2 class="mt-10 mb-6 text-lg font-semibold tracking-tight">Days</h2>}

  <div class:list={['gap-8', hasJourney && 'lg:grid lg:grid-cols-[minmax(0,1fr)_380px] lg:items-start']}>
    <ol class="relative space-y-10 border-l border-slate-200 pl-6 dark:border-slate-800">
    {
      days.map((day, i) => {
        const { tracks, photos } = dayExtras[i];
        return (
          <li
            class:list={['relative', hasJourney && 'snap-start']}
            data-day-index={hasJourney ? i : undefined}
          >
            <span class="absolute -left-[1.6rem] top-1.5 h-2.5 w-2.5 rounded-full bg-sky-600 dark:bg-sky-400" />

            <time class="text-sm text-slate-500 dark:text-slate-400">{dayFormatter.format(day.date)}</time>
            <h3 class="text-xl font-semibold tracking-tight">{day.title}</h3>

            {day.places.length > 0 && (
              <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{day.places.join(' · ')}</p>
            )}

            {day.activities.length > 0 && (
              <ul class="mt-3 flex flex-wrap gap-2">
                {day.activities.map((activity) => (
                  <li class="rounded-full bg-slate-100 px-3 py-1 text-xs text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                    {activity}
                  </li>
                ))}
              </ul>
            )}

            {day.notes && (
              <div class="prose prose-slate mt-4 max-w-none dark:prose-invert" set:html={renderNotesHtml(day.notes)} />
            )}

            {photos.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-2">
                {photos.map(({ thumb, full }) => (
                  <button
                    type="button"
                    data-lightbox-full={full.src}
                    data-lightbox-alt={day.title}
                    class="block overflow-hidden rounded-md border border-slate-200 dark:border-slate-800"
                  >
                    <img src={thumb.src} {...thumb.attributes} alt={day.title} class="h-24 w-32 object-cover" />
                  </button>
                ))}
              </div>
            )}

            {tracks.map((entry) => (
              <div class="mt-4">
                {tracks.length > 1 && <p class="mb-2 text-sm font-medium">{entry.label}</p>}
                <dl class="mt-4 grid grid-cols-2 gap-4 text-sm sm:grid-cols-4">
                  <div>
                    <dt class="text-slate-500 dark:text-slate-400">Distance</dt>
                    <dd class="font-medium">{entry.track.distanceKm.toFixed(1)} km</dd>
                  </div>
                  <div>
                    <dt class="text-slate-500 dark:text-slate-400">Elevation gain</dt>
                    <dd class="font-medium">{Math.round(entry.track.elevationGainM)} m</dd>
                  </div>
                  <div>
                    <dt class="text-slate-500 dark:text-slate-400">Elevation loss</dt>
                    <dd class="font-medium">{Math.round(entry.track.elevationLossM)} m</dd>
                  </div>
                  {entry.track.durationMinutes !== null && (
                    <div>
                      <dt class="text-slate-500 dark:text-slate-400">Duration</dt>
                      <dd class="font-medium">
                        {Math.floor(entry.track.durationMinutes / 60)}h {Math.round(entry.track.durationMinutes % 60)}m
                      </dd>
                    </div>
                  )}
                </dl>
                {entry.href && (
                  <a href={entry.href} download class="mt-4 inline-block text-sm font-medium text-sky-600 dark:text-sky-400">
                    Download activity GPX
                  </a>
                )}
              </div>
            ))}

            {routeDownloads[i] && (
              <div class="mt-4">
                <a
                  href={routeDownloads[i]!.href}
                  download={routeDownloads[i]!.filename}
                  class="inline-block text-sm font-medium text-sky-600 dark:text-sky-400"
                >
                  Download route GPX
                </a>
              </div>
            )}
          </li>
        );
      })
    }
    </ol>

    {hasJourney && (
      <div class="lg:sticky lg:top-6">
        <DayFocusMap client:load days={journeyDays} />
      </div>
    )}
  </div>

  <Lightbox />
</Layout>
