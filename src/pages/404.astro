---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found">
  <div class="py-20 text-center">
    <h1 class="text-3xl font-bold tracking-tight">404</h1>
    <p class="mt-2 text-slate-600 dark:text-slate-400">This page doesn't exist.</p>
    <a href="/" class="mt-6 inline-block text-sky-600 hover:underline dark:text-sky-400">Go home</a>
  </div>
</Layout>
