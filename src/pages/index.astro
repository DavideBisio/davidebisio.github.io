---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { profile } from '../data/cv';
import { articleSlug } from '../lib/articles';

const latestArticles = (await getCollection('articles', ({ data }) => !data.draft && data.category === 'professional'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const siteUrl = new URL('/', Astro.site).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.title,
  description: profile.summary,
  url: siteUrl,
};
---

<Layout title={profile.name} description="Digital verification by day, geek by night, outdoors the rest of the time. Writing, experimenting with AI and building things." structuredData={structuredData}>
  <section class="mb-16">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{profile.name}</h1>
    <p class="mt-2 text-lg text-slate-600 dark:text-slate-400">Digital Verification Engineer · Geek · Outdoors Enthusiast</p>
    <div class="mt-6 max-w-2xl space-y-6 leading-relaxed text-slate-700 dark:text-slate-300">
      <div>
        <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-400">Who am I</h2>
        <p class="mt-1">
          By day, I work in digital verification. By night, I'm a geek. The rest of the time, you'll find me
          outdoors. What ties it all together is that I love building things and seeing goals through.
        </p>
      </div>
      <div>
        <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-400">Why this site</h2>
        <p class="mt-1">
          This is where I think out loud: writing is how I work through a topic. Here I experiment with AI and
          share whatever turns out to be worth sharing.
        </p>
      </div>
      <div>
        <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-400">How I use AI</h2>
        <p class="mt-1">
          AI is a remarkable tool, but it doesn't do the creating for me. The ideas are mine; AI sharpens them. I
          also use it to learn about AI itself and plenty else. I can't spend days digging into every detail, so I
          hand the non-creative groundwork to AI and keep my time for the thinking.
        </p>
      </div>
      <p>
        Enjoy, and if something resonates, <a href="/contact/" class="font-medium text-sky-600 dark:text-sky-400">get in touch</a>.
      </p>
    </div>
    <div class="mt-6 flex gap-4">
      <a
        href="/cv/"
        class="rounded-md bg-sky-600 px-4 py-2 text-sm font-medium text-offwhite transition-colors hover:bg-sky-700 hover:text-slate-base"
      >
        View CV
      </a>
      <a
        href="/articles/"
        class="rounded-md border border-slate-300 px-4 py-2 text-sm font-medium transition-colors hover:border-sky-600 hover:text-sky-600 dark:border-teal dark:hover:border-sky-400 dark:hover:text-sky-400"
      >
        Read articles
      </a>
    </div>
  </section>

  {
    latestArticles.length > 0 && (
      <section>
        <h2 class="mb-4 text-xl font-semibold">Latest articles</h2>
        <ul class="space-y-4">
          {latestArticles.map((article) => (
            <li>
              <a href={`/articles/${articleSlug(article)}/`} class="group block">
                <p class="font-medium group-hover:text-sky-600 dark:group-hover:text-sky-400">
                  {article.data.title}
                </p>
                <p class="text-sm text-slate-500 dark:text-slate-400">{article.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Layout>
