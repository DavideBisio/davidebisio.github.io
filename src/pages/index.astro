---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { profile } from '../data/cv';
import { articleSlug } from '../lib/articles';

const latestArticles = (await getCollection('articles', ({ data }) => !data.draft && data.category === 'professional'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const siteUrl = new URL('/', Astro.site).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.title,
  description: profile.summary,
  url: siteUrl,
};
---

<Layout title={profile.name} description="Digital verification by the day, geek by the night and outdoor enthusiast in every other moment." structuredData={structuredData}>
  <section class="mb-16">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{profile.name}</h1>
    <p class="mt-2 text-lg text-slate-600 dark:text-slate-400">{profile.title}</p>
    <div class="mt-6 max-w-2xl space-y-6 leading-relaxed text-slate-700 dark:text-slate-300">
      <div>
        <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Who am I</h2>
        <p class="mt-1">
          Digital verification by the day, geek by the night and outdoor enthusiast in every other moment of my
          life. I love creating things and achieving goals.
        </p>
      </div>
      <div>
        <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Purpose of this site</h2>
        <p class="mt-1">
          Thinking about topics while writing down text, experimenting with AI, and creating some valuable content.
        </p>
      </div>
      <div>
        <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">How I use AI</h2>
        <p class="mt-1">
          AI is an awesome tool. I don't create <em>with</em> AI: the ideas are mine, AI makes them better. I also
          use it to learn about AI and much more. I can't spend days on every single aspect, so I delegate the
          non-creative work to AI.
        </p>
      </div>
      <p>
        Enjoy, and <a href="/contact/" class="font-medium text-sky-600 dark:text-sky-400">contact me</a> if you
        like.
      </p>
    </div>
    <div class="mt-6 flex gap-4">
      <a
        href="/cv/"
        class="rounded-md bg-sky-600 px-4 py-2 text-sm font-medium text-offwhite transition-colors hover:bg-sky-700 hover:text-slate-base"
      >
        View CV
      </a>
      <a
        href="/articles/"
        class="rounded-md border border-slate-300 px-4 py-2 text-sm font-medium transition-colors hover:border-sky-600 hover:text-sky-600 dark:border-teal dark:hover:border-sky-400 dark:hover:text-sky-400"
      >
        Read articles
      </a>
    </div>
  </section>

  {
    latestArticles.length > 0 && (
      <section>
        <h2 class="mb-4 text-xl font-semibold">Latest articles</h2>
        <ul class="space-y-4">
          {latestArticles.map((article) => (
            <li>
              <a href={`/articles/${articleSlug(article)}/`} class="group block">
                <p class="font-medium group-hover:text-sky-600 dark:group-hover:text-sky-400">
                  {article.data.title}
                </p>
                <p class="text-sm text-slate-500 dark:text-slate-400">{article.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Layout>
