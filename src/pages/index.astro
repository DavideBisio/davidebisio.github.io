---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { profile } from '../data/cv';

const latestArticles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Layout title={profile.name} description={profile.summary}>
  <section class="mb-16">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{profile.name}</h1>
    <p class="mt-2 text-lg text-slate-600 dark:text-slate-400">{profile.title}</p>
    <p class="mt-6 max-w-2xl leading-relaxed text-slate-700 dark:text-slate-300">
      {profile.summary}
    </p>
    <div class="mt-6 flex gap-4">
      <a
        href="/cv/"
        class="rounded-md bg-sky-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-sky-700"
      >
        View CV
      </a>
      <a
        href="/articles/"
        class="rounded-md border border-slate-300 px-4 py-2 text-sm font-medium transition-colors hover:border-sky-600 hover:text-sky-600 dark:border-slate-700 dark:hover:border-sky-400 dark:hover:text-sky-400"
      >
        Read articles
      </a>
    </div>
  </section>

  {
    latestArticles.length > 0 && (
      <section>
        <h2 class="mb-4 text-xl font-semibold">Latest articles</h2>
        <ul class="space-y-4">
          {latestArticles.map((article) => (
            <li>
              <a href={`/articles/${article.id}/`} class="group block">
                <p class="font-medium group-hover:text-sky-600 dark:group-hover:text-sky-400">
                  {article.data.title}
                </p>
                <p class="text-sm text-slate-500 dark:text-slate-400">{article.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Layout>
