---
import Layout from '../../../layouts/Layout.astro';
import ArticleList from '../../../components/ArticleList.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return [
    { params: { category: 'professional' } },
    { params: { category: 'hobby' } },
  ];
}

const { category } = Astro.params as { category: 'hobby' | 'professional' };
const articles = await getCollection('articles', ({ data }) => !data.draft && data.category === category);

const titles = { professional: 'Professional articles', hobby: 'Hobby articles' } as const;
---

<Layout title={titles[category]} description={`Articles about ${category === 'hobby' ? 'my hobbies' : 'my professional work'}.`}>
  <h1 class="mb-6 text-2xl font-bold tracking-tight">{titles[category]}</h1>
  <ArticleList articles={articles} activeCategory={category} />
</Layout>
