---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { articleSlug } from '../../lib/articles';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft && data.category === 'hobby');
  return articles.map((article) => ({
    params: { slug: articleSlug(article) },
    props: { article },
  }));
}

const { article } = Astro.props as { article: CollectionEntry<'articles'> };
const { Content } = await render(article);
---

<ArticleLayout
  title={article.data.title}
  description={article.data.description}
  pubDate={article.data.pubDate}
  updatedDate={article.data.updatedDate}
  backHref="/interests/"
  backLabel="Interests"
  tags={article.data.tags}
>
  <Content />
</ArticleLayout>
